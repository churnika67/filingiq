# Same Snowflake connection the app uses — see app/.env.example for how
# to find your account identifier.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FILINGIQ_WH
# Leave blank to log in through your browser. Or paste a password / PAT.
SNOWFLAKE_PASSWORD=

# Groq — free key, no payment method: https://console.groq.com/keys
GROQ_API_KEY=
