# Snowflake — account identifier is the part before .snowflakecomputing.com,
# e.g. ORGNAME-ACCOUNTNAME (Snowsight: bottom-left menu > your account > "Copy account identifier")
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FILINGIQ_WH
# Leave blank to log in through your browser (recommended: no secret on disk).
# Or paste a password / Programmatic Access Token.
SNOWFLAKE_PASSWORD=

# Groq — free key, no payment method: https://console.groq.com/keys
GROQ_API_KEY=

FILINGIQ_TOP_K=6
