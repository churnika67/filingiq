# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local environments
.env
.venv/
venv/

# Source 10-K PDFs are large and not meant to be committed to git.
# Keep the stage (Snowflake) as the source of truth for the actual files.
*.pdf

# Evaluation outputs are generated by eval_notebook.ipynb — keep the
# folder structure tracked, but not every regenerated run's artifacts.
eval/results/*.csv
eval/results/*.png
!eval/results/.gitkeep

# Don't commit real screenshots with sensitive account/billing info by
# accident without reviewing first — comment this out once you've
# checked screenshots are safe to share.
# docs/screenshots/*.png
